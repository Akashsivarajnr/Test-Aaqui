# Thozhil Orchestration Layer Environment Variables

# Service Adapter URLs (Used by Orchestrator)
RESUME_SERVICE_URL=http://resume-service:8001
PROJECT_SERVICE_URL=http://project-service:8002
CODING_SERVICE_URL=http://coding-service:8003
VIDEO_SERVICE_URL=http://video-service:8004

# Gating Thresholds
RESUME_MIN_SCORE=60.0
PROJECT_MIN_SCORE=60.0
CODING_MIN_SCORE=60.0
VIDEO_MIN_SCORE=60.0

# Port Configurations
ORCHESTRATOR_PORT=8000
RESUME_SERVICE_PORT=8001
PROJECT_SERVICE_PORT=8002
CODING_SERVICE_PORT=8003
VIDEO_SERVICE_PORT=8004

# Database Config
DATABASE_PATH=orchestrator.db

# Underlying Applications Ports & Keys (Reference)
# Project A Video Interviewer: PORT=5010, FRONTEND_PORT=5011
# Project B Resume Screener: PORT=5020
# Project C Project Analyser: PORT=5030, AI_PORT=5031, FRONTEND_PORT=5032
# Project D Coding Interviewer: PORT=5040, ADMIN_PORT=5041, CANDIDATE_PORT=5042
