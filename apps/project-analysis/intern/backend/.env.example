# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

DATABASE_URL="postgresql://user:password@host:port/db"
SUPABASE_URL="https://your-project.supabase.co"

# Use the ANON key here (not the service_role key).
# The service_role key bypasses Row Level Security — keep it out of this file.
SUPABASE_KEY="your-supabase-anon-key"

AI_SERVICE_URL=http://localhost:8000
GOOGLE_API_KEY=your-google-api-key
AI_PROVIDER=gemini

# Set to "true" to use the built-in heuristic reviewer instead of the Gemini pipeline.
# Replaces the old (incorrect) ANTHROPIC_API_KEY-based detection.
USE_MOCK_REVIEWER=false
