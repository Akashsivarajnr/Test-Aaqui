# Module 3 – AI Reviewer Engine — Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control (it is listed in .gitignore).

# ── AI Provider ──────────────────────────────────────────────────────────────
# Which AI provider to use. Currently supported: "gemini"
# Future values: "openai", "claude", "ollama", "azure_openai"
AI_PROVIDER=gemini

# Your Google Generative AI (Gemini) API key.
GOOGLE_API_KEY=your-google-api-key

# Gemini model to use.
AI_MODEL_NAME=gemini-2.0-flash

# AI response temperature (0.0 = deterministic, 1.0 = creative).
# Keep close to 0 for consistent JSON output.
AI_TEMPERATURE=0.2

# Maximum tokens in the AI response.
MAX_OUTPUT_TOKENS=4096

# Seconds before the AI request times out and returns HTTP 504.
AI_REQUEST_TIMEOUT_SECONDS=60

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# "browser"    – Module 3 returns speech_text; the frontend calls the Browser Speech API.
# "google_tts" – Future: server-side audio via Google Cloud TTS.
# "elevenlabs" – Future: server-side audio via ElevenLabs.
TTS_PROVIDER=browser

# ── Application ───────────────────────────────────────────────────────────────
APP_TITLE=AI Reviewer Engine
APP_VERSION=1.0.0
APP_DESCRIPTION=Module 3 – Evaluates intern project submissions using AI and returns structured feedback.

# Set to true for verbose debug logging during development.
# WARNING: Do NOT set to true in production.
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Use "*" for open access (development only).
# Example: ALLOWED_ORIGINS=["https://your-app.com","https://staging.your-app.com"]
ALLOWED_ORIGINS=["*"]

# Maximum request body size in bytes. Default: 524288 (512 KB).
MAX_REQUEST_SIZE_BYTES=524288

# Maximum review requests per minute per client IP. Default: 10.
RATE_LIMIT_PER_MINUTE=10
