SANDBOX_RESULT_TTL=300
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=100000
SANDBOX_CPU_PERIOD=100000

# Docker images used by the sandbox (server-controlled whitelist)
